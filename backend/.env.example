# Supabase Configuration
# Get these from your Supabase project settings: https://app.supabase.com/project/_/settings/api
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Backend Configuration
NODE_ENV=development
PORT=4000
# Generate a strong JWT secret: openssl rand -base64 32
JWT_SECRET=your_secure_jwt_secret_min_32_characters
REDIS_URL=redis://localhost:6379

# Payment Gateway
# Get your Razorpay credentials from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Admin Credentials
# IMPORTANT: Change these immediately after first deployment!
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change_this_secure_password_immediately

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password

# Monitoring
LOG_LEVEL=info
